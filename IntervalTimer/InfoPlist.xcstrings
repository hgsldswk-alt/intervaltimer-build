    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你选择保存的训练成绩图添加到照片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your workout result image to Photos when you choose to save it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將你選擇儲存的訓練成績圖加入照片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存を選んだときに、ワークアウトの結果画像を写真に追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장을 고르면 운동 결과 이미지를 사진에 추가합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt dein Trainingsergebnis zu Fotos hinzu, wenn du es sicherst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega la imagen de tu resultado a Fotos cuando decides guardarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute l’image de ta séance à Photos quand tu choisis de l’enregistrer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona a imagem do resultado do treino às Fotos quando você escolhe salvar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge l’immagine del risultato dell’allenamento a Foto quando scegli di salvarla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt de afbeelding van je trainingsresultaat toe aan Foto's als je kiest om die te bewaren."
          }
        }
      }
    }
  },
  "version": "1.0"
}
