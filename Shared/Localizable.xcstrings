    "privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练方案、记录与偏好保存在本机。App 无账号、广告、统计或训练上传。只有在你主动导出、复制或分享时，才会向系统分享菜单或剪贴板交付相应内容。\n\n锁屏提醒由 iOS 调度，可在设置中关闭。购买和恢复由 Apple StoreKit 处理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plans, session history and preferences stay on this device. The app has no account, advertising, analytics or workout upload. Content goes to the system share sheet or clipboard only when you export, share or copy it.\n\nLock screen alerts are scheduled by iOS and can be turned off in Settings. Purchases and restores use Apple StoreKit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訓練方案、紀錄與偏好儲存在本機。App 無帳號、廣告、分析或訓練上傳。只有在你主動匯出、複製或分享時，才會向系統分享選單或剪貼簿交付相關內容。\n\n鎖定畫面提醒由 iOS 排程，可在設定中關閉。購買和恢復由 Apple StoreKit 處理。"
          }
        }
      }
    },
