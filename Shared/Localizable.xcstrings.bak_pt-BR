    "planShare.help": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把方案文件或口令发给学员，对方导入后就能按同一方案开练。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the file or code so others can import and run the same plan."
