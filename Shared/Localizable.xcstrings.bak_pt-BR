          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work 5–600 s, rest 0–600 s, warm-up and cool-down 0–120 s each, 1–24 rounds."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訓練 5–600 秒，休息 0–600 秒，準備及收操各 0–120 秒，1–24 輪。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運動5〜600秒、休憩0〜600秒、ウォームアップとクールダウンは各0〜120秒、1〜24ラウンドです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동 5–600초, 휴식 0–600초, 워밍업과 쿨다운 각 0–120초, 1–24라운드."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belastung 5–600 s, Erholung 0–600 s, Aufwärmen und Abkühlen je 0–120 s, 1–24 Runden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabajo 5–600 s, descanso 0–600 s, calentamiento y enfriamiento 0–120 s cada uno, 1–24 rondas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effort 5–600 s, repos 0–600 s, échauffement et retour au calme 0–120 s chacun, 1–24 tours."
          }
        }
      }
