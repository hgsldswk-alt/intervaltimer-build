    "purchase.once": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用从首次打开收费版起计，领取凭证不会重置。无订阅，到期不会扣费。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trial starts on first launch of the paid version. Claiming a receipt does not restart it. No subscription or automatic charge."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用從首次開啟收費版起算，領取憑證不會重設。無訂閱，到期不會扣款。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お試しは有料版を初めて起動した日から始まります。レシートを受け取ってもやり直しにはなりません。サブスクや自動課金はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험은 유료 버전을 처음 실행할 때 시작됩니다. 영수증을 받아도 다시 시작되지 않습니다. 구독이나 자동 결제가 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Testphase beginnt beim ersten Start der Kaufversion. Ein Beleg startet sie nicht neu. Kein Abo, keine automatische Abbuchung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba empieza al abrir por primera vez la versión de pago. Obtener un recibo no la reinicia. Sin suscripción ni cobro automático."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essai commence à la première ouverture de la version payante. Obtenir un reçu ne le relance pas. Sans abonnement ni paiement automatique."
          }
        }
      }
    },
